# Email Service
NUXT_RESEND_API_KEY=
NUXT_QUOTE_FROM_EMAIL=
NUXT_QUOTE_DESTINATION_EMAIL=wssitconsultoria@gmail.com

# Anti-spam (Cloudflare Turnstile)
NUXT_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics (Google Analytics 4)
NUXT_PUBLIC_GA_ID=

# Site URL (used for canonical, sitemap, OpenGraph)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep test sites out of search engines; set true only for the final public site.
NUXT_PUBLIC_SITE_INDEXABLE=false

# "email-client" prepares a message in the visitor's email app, without automatic delivery.
# "server" requires a validated sender, Resend and Turnstile.
# "formsubmit" sends via the provider's security check after email activation.
NUXT_PUBLIC_QUOTE_DELIVERY_MODE=server
